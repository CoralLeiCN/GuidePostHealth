# Browser-facing API URL used by the frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend settings use the NEXTSTEP_ prefix.
NEXTSTEP_CODEX_ENABLED=true
NEXTSTEP_CODEX_MODEL=gpt-5.6-terra
NEXTSTEP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NEXTSTEP_AUTO_INDEX=true
