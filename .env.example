# Browser-facing API URL used by the frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend settings use the GUIDEPOST_ prefix.
GUIDEPOST_CODEX_ENABLED=true
GUIDEPOST_CODEX_MODEL=gpt-5.6-terra
GUIDEPOST_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GUIDEPOST_QDRANT_URL=http://127.0.0.1:6333
GUIDEPOST_QDRANT_TIMEOUT_SECONDS=5
